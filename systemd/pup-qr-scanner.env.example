# Optional overrides for the QR scanner service.
# Copy this to /etc/default/pup-qr-scanner and edit as needed.

# Backend base URL or full scan endpoint.
# Example Cloud Run URL: https://deans-server-x4daosqtwq-an.a.run.app
SCANNER_SERVER_URL=https://deans-server-x4daosqtwq-an.a.run.app

# Explicit scanner device path if auto-detection picks the wrong one.
# Example: /dev/input/event4
# SCANNER_DEVICE=/dev/input/event4

# Optional device name hint to improve auto-detection.
# Example: Honeywell
# SCANNER_NAME_HINT=
